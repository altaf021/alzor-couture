
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/images/prod_(.*)",
      "dest": "app.py"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "app.py"
    },
    {
      "src": "/favicon.ico",
      "dest": "/static/images/logo.png"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
