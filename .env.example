# =============================================================================
# ALZOR COUTURE — ENVIRONMENT CONFIGURATION (.env)
# =============================================================================

# 1. Primary Website Domain
# Used for canonical links, sitemaps, OpenGraph, and Razorpay redirects.
SITE_URL=https://alzorcouture.in

# 2. Flask Secret Key (REQUIRED in production)
# Generate a strong 64-character random string (e.g. python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=replace-with-a-secure-random-hex-string

# 3. Razorpay API Credentials
# NOTE ON TEST MODE VS LIVE MODE:
# - If your key starts with "rzp_test_", Razorpay Checkout displays a yellow "[TEST MODE]" banner.
# - Once your Razorpay account is activated (KYC approved):
#     1) Log into https://dashboard.razorpay.com
#     2) In the top navigation bar, toggle the switch from "Test Mode" to "Live Mode"
#     3) Go to Account & Settings -> API Keys (or Developer Controls -> API Keys)
#     4) Click "Generate Key" or "Regenerate Live Key"
#     5) Copy the Key ID (starts with "rzp_live_") and Key Secret below
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET_HERE

# 4. Database URL (PostgreSQL)
# For Render / Supabase / Neon deployment, paste your PostgreSQL connection string here.
# If left empty, Alzor Couture automatically uses a local SQLite database (orders.db).
DATABASE_URL=

# 5. Server Options
PORT=5000
FLASK_DEBUG=false
