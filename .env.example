# =========================================================
# ALZOR COUTURE — Environment Variables
# Copy this file to .env and fill in your values.
# =========================================================

# Required: Strong random secret key for Flask sessions
FLASK_SECRET_KEY=your-strong-secret-key-here

# Optional: Set to "true" to enable Flask debug mode locally
FLASK_DEBUG=true

# Required for checkout/payments: PostgreSQL connection string
# (Leave blank to run locally without payment features)
DATABASE_URL=

# Required for payments: Razorpay API keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Port to listen on (default: 5000)
# PORT=5000
